# Convex (web app)
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Kinde human auth (@kinde-oss/kinde-auth-nextjs). Fill from your Kinde dashboard
# in .env.local before signing in.
KINDE_CLIENT_ID=
KINDE_CLIENT_SECRET=
KINDE_ISSUER_URL=
KINDE_SITE_URL=http://localhost:3000
KINDE_POST_LOGIN_REDIRECT_URL=http://localhost:3000
KINDE_POST_LOGOUT_REDIRECT_URL=http://localhost:3000

# IMPORTANT: do NOT set KINDE_AUDIENCE in the web app's env. The kinde-auth-nextjs
# SDK would attach it to the human sign-in flow and BREAK login. KINDE_AUDIENCE is
# an M2M concern for the Convex component (agent token verification) and is set as
# a Convex deployment env var (npx convex env set ...) in P6 — never here.

# AUTHZ_MODE is a CONVEX DEPLOYMENT env var (set via `npx convex env set AUTHZ_MODE
# broken|enforced`), read server-side only — never from a request. Defaults to
# "broken" for this phase (P5). It is NOT a web-process env var, so it is not set
# in this file.
