# Kinde M2M (agent identities). No live call happens at import — only when
# mintAgentToken() is invoked. Fill these from your Kinde dashboard in .env.local.

# The Kinde M2M token endpoint, e.g. https://<your-org>.kinde.com/oauth2/token
KINDE_M2M_TOKEN_URL=
# The locker API audience the agent tokens are minted for.
KINDE_M2M_AUDIENCE=

# Each agent is a SEPARATE Kinde M2M application -> distinct client id/secret,
# hence a distinct identity.
INTAKE_CLIENT_ID=
INTAKE_CLIENT_SECRET=
REVIEW_CLIENT_ID=
REVIEW_CLIENT_SECRET=
DISPOSITION_CLIENT_ID=
DISPOSITION_CLIENT_SECRET=

# Langfuse tracing (OPTIONAL). If both keys are absent the graph runs normally and
# no exporter is registered — no crash. Fill from your Langfuse project to see
# traces; verify them in the Langfuse dashboard.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Defaults to Langfuse cloud if unset.
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# App HTTP base URL the agents POST run events to (the Convex deployment's
# HTTP actions URL, e.g. https://<deployment>.convex.site).
LOCKER_API_BASE_URL=
